# Copy to .env for local development without Docker. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://frutti:frutti@localhost:5432/frutti

# E-mail (D-206): the company mailbox documents are sent from. Without EMAIL_HOST the dev server prints them.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=contact@fruttidelmare.com

# WhatsApp assistant (Phase 12, D-307). Off until the Meta number and the keys are set.
ASSISTANT_ENABLED=false
ASSISTANT_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
